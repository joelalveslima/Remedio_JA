{
  "name": "remedio-ja-api",
  "version": "2.0.0",
  "description": "API para gerenciamento de unidades de saúde e medicamentos do app Remédio JÁ",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "echo 'Build completed'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "node src/database/migrate.js",
    "db:sync": "node -e \"require('./src/models').sequelize.sync({force: false}).then(() => process.exit(0))\"",
    "db:seed": "node src/database/seed.js",
    "db:seed:force": "node src/database/seed.js --force",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "npm run db:migrate && npm run db:seed:force",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js"
  },
  "keywords": [
    "healthcare",
    "pharmacy",
    "api",
    "nodejs",
    "express",
    "health-units"
  ],
  "author": "Joel Alves Lima",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joelalveslima/Remedio_JA.git"
  },
  "bugs": {
    "url": "https://github.com/joelalveslima/Remedio_JA/issues"
  },
  "homepage": "https://github.com/joelalveslima/Remedio_JA#readme"
}
