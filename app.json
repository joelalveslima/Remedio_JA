{
  "expo": {
    "name": "Remédio Já",
    "slug": "Remedio_JA",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#21796A"
    },
    "android": {
      "backgroundColor": "#21796A",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "statusBar": {
        "backgroundColor": "#21796A",
        "barStyle": "light-content",
        "translucent": true
      }
    },
    "ios": {
      "statusBar": {
        "barStyle": "light-content"
      }
    },
    "web": {},
    "permissions": ["LOCATION", "CAMERA", "CAMERA_ROLL"]
  }
}
